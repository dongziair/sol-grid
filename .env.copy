# ===== Solana / Jupiter =====
SOL_RPC_URL=https://api.mainnet-beta.solana.com
SOL_PRIVATE_KEYS=你的bs58私钥（可多个逗号分隔，但本代码默认只用第一个）
JUP_API_KEY=你的JupiterUltraKey
JUP_BASE=https://api.jup.ag/ultra/v1

# ===== Mints =====
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SOL_MINT=So11111111111111111111111111111111111111112

# ===== Pyth Hermes：价格触发源 =====
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_QUERY=SOL/USD
PYTH_ASSET_TYPE=crypto
PRICE_CHECK_INTERVAL_MS=5000

# ===== 网格（高成交）=====
GRID_RANGE_PERCENT=4
GRID_COUNT=60

# 同一层最多持仓数（提高成交频率）
MAX_POS_PER_LEVEL=3

# 每tick最多成交（限制 burst）
MAX_TRADES_PER_TICK=3
POST_TRADE_COOLDOWN_MS=800

# 每笔随机下单 SOL 数量
MIN_TRADE_SOL=0.0006
MAX_TRADE_SOL=0.0015

# 余额安全垫（gas）
MIN_BALANCE_SOL=0.02

# ===== 方案B：USDC 缓冲 =====
TARGET_USDC_BUFFER=8
MIN_SOL_KEEP=0.10

# ===== 网格漂移（避免跑出区间后无成交）=====
REGRID_OUTSIDE_PCT=0.8
REGRID_COOLDOWN_MS=1800000

# 可选代理（不用就留空）
# SOL_PROXIES=host:port:user:pass
